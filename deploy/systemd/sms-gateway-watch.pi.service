[Unit]
Description=SMS Gateway watch daemon (forward incoming SMS)
After=network-online.target
Wants=network-online.target
# No dependency on sms-tunnel.service at all. The household gateway already
# routes non-RU traffic out of the country, so the SSH SOCKS tunnel was a second
# hop to the same VPS rather than a fallback: its own packets were marked and
# sent through that same exit, so it could not survive the exit failing.
# Set telegram.proxy_url again, and re-enable the tunnel, if this Pi is ever
# moved behind a gateway without that split tunnel.
#
# Never stop trying. The default start limit gives up after 5 restarts in 10s
# and leaves the gateway down until someone notices.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/legion/smsgateway
ExecStart=/home/legion/smsgateway/bin/sms-gateway-watch
EnvironmentFile=-/etc/sms-gateway/env
# always, not on-failure: a clean exit still means no SMS are being received.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
